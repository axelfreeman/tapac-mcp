{
  "name": "@tapacapi/sdk",
  "version": "1.0.1",
  "description": "Official JavaScript/TypeScript SDK for TAPAC — find and verify B2B contacts programmatically (ESM + CJS, zero dependencies).",
  "license": "MIT",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelfreeman/tapac-mcp.git",
    "directory": "sdk/js"
  },
  "homepage": "https://tapacapi.com/developers",
  "bugs": {
    "url": "https://github.com/axelfreeman/tapac-mcp/issues"
  },
  "keywords": [
    "tapac",
    "b2b",
    "contacts",
    "lead-generation",
    "email-verification",
    "smtp",
    "mcp",
    "apollo-alternative",
    "hunter-alternative"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
